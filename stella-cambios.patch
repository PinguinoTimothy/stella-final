+import { describe, expect, it, beforeEach } from 'vitest'
+import { mount } from '@vue/test-utils'
+import { nextTick } from 'vue'
+import { createPinia, setActivePinia } from 'pinia'
+import CombatPanel from '../src/components/Combat/CombatPanel.vue'
+import { useAppStore } from '../src/stores/app'
+import { useMonsterFights } from '../src/stores/monsterFights'
+import { useInitiative } from '../src/stores/initiative'
+import { sampleParty, sampleState } from './helpers'
+
+function setup() {
+  localStorage.clear()
+  const pinia = createPinia(); setActivePinia(pinia)
+  const app = useAppStore(); app.replace(sampleState(), sampleParty())
+  const fights = useMonsterFights()
+  fights.addCustom('Goblin', 7); fights.addCustom('Goblin', 7)
+  const init = useInitiative()
+  const w = mount(CombatPanel, { global: { plugins: [pinia] } })
+  return { app, fights, init, w }
+}
+const names = (w) => w.findAll('.cp-row').map((r) => r.find('.cp-name').text())
+
+describe('combat panel', () => {
+  beforeEach(() => { document.body.innerHTML = '' })
+
+  it('two creatures with the same name get different names', () => {
+    const { fights } = setup()
+    expect(fights.fights.map((f) => f.name)).toEqual(['Goblin', 'Goblin 2'])
+  })
+
+  it('shows party and monsters in one list, ordered by initiative', async () => {
+    const { init, w } = setup()
+    init.setInit('mon:Goblin', 15); init.setInit('pc:Bob', 12); init.setInit('pc:Ann', 10); init.setInit('mon:Goblin 2', 8)
+    await nextTick()
+    expect(names(w)).toEqual(['Goblin', 'Bob', 'Ann', 'Goblin 2'])
+    expect(w.find('.cp-row.mon .cp-hp').text()).toContain('7/7')   // HP is on the same row as the turn order
+  })
+
+  it('Next turn marks the row and aims the damage buttons at that monster', async () => {
+    const { fights, init, w } = setup()
+    init.setInit('mon:Goblin', 15); init.setInit('pc:Bob', 12); init.setInit('pc:Ann', 10); init.setInit('mon:Goblin 2', 8)
+    await nextTick()
+    await w.find('.cp-next').trigger('click')
+    await nextTick()
+    expect(w.find('.cp-row.current .cp-name').text()).toBe('Goblin')
+    expect(fights.active.name).toBe('Goblin')
+    await w.find('button[aria-label="Minus 5"]').trigger('click')
+    expect(fights.fights[0].hp).toBe(2)
+  })
+})
